POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=skeddie

# Sign-in (apps/solver/auth.py). The API rejects every organization route
# with 503 until AUTH_ISSUER and AUTH_AUDIENCE are set.
#   AUTH_ISSUER    your identity provider's issuer URL (the token's `iss`)
#   AUTH_AUDIENCE  the identifier your provider puts in the token's `aud`
#   AUTH_JWKS_URL  optional; defaults to the issuer's OIDC discovery document
# For local development without a provider, run
# `python apps/solver/scripts/dev_auth.py keys` and paste the lines it prints.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
